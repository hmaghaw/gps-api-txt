# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Required: OpenAI API key used by app/pipeline/classify.py (moderation)
# and app/pipeline/rewrite.py (rewrite).
OPENAI_API_KEY=sk-...

# Optional: model used for both the classification and rewrite calls.
OPENAI_MODEL=gpt-4o-mini

# Optional: only set this if routing through an Azure OpenAI or other
# OpenAI-compatible endpoint. Leave unset to use the default OpenAI API.
# OPENAI_BASE_URL=

# Optional: per-request timeout (seconds) for OpenAI calls.
OPENAI_REQUEST_TIMEOUT=20
