# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Required: OpenAI API key used by app/pipeline/classify.py (moderation)
# and app/pipeline/rewrite.py (rewrite).
OPENAI_API_KEY=sk-...

# Optional: model used for both the classification and rewrite calls.
OPENAI_MODEL=gpt-4o-mini

# Optional: only set this if routing through an Azure OpenAI or other
# OpenAI-compatible endpoint. Leave unset to use the default OpenAI API.
# OPENAI_BASE_URL=

# Optional: per-request timeout (seconds) for OpenAI calls.
OPENAI_REQUEST_TIMEOUT=20

# Comma-separated list of language codes (ISO 639-1) this deployment
# accepts. Each code MUST have a matching entry in languages.json at the
# project root, or the service will refuse to start. Add/remove languages
# here without touching code.
SUPPORTED_LANGUAGES=en,es,fr,ar,pt,de

# Used for labels/docs only — does not affect which languages are accepted.
DEFAULT_LANGUAGE=en

# Minimum confidence the language-detection step must report before a
# message is processed in that language. Below this, the message is
# rejected as unsupported rather than risking a misdetection.
LANG_CONFIDENCE_THRESHOLD=0.6
